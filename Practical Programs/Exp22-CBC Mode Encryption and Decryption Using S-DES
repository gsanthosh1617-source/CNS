#include <stdio.h>
int main()
{
    int p[4] = {1, 35, 69, 103};
    int c[4], d[4], iv = 170;
    int a = 5, b = 8, i, x;

    for(i = 0; i < 4; i++)
    {
        x = p[i] ^ (i == 0 ? iv : c[i-1]);
        c[i] = (a * x + b) % 256;
    }

    printf("Ciphertext: ");
    for(i = 0; i < 4; i++)
        printf("%d ", c[i]);

    for(i = 0; i < 4; i++)
    {
        x = c[i] - b;
        if(x < 0) x += 256;
        x = (205 * x) % 256;
        d[i] = x ^ (i == 0 ? iv : c[i-1]);
    }

    printf("\nDecrypted plaintext: ");
    for(i = 0; i < 4; i++)
        printf("%d ", d[i]);

    return 0;
}

SAMPLE INPUT
Plaintext: 1 35 69 103
IV: 170
a = 5, b = 8

SAMPLE OUTPUT
Ciphertext: 13 222 99 126
Decrypted plaintext: 1 35 69 103
