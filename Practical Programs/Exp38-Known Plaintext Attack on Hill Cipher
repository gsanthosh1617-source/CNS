#include <stdio.h>

int main()
{
    int p[2][2], c[2][2], k[2][2];
    int det, inv, i, j;

    printf("Enter 4 plaintext values (0-25):\n");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&p[i][j]);

    printf("Enter 4 ciphertext values (0-25):\n");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&c[i][j]);

    det=(p[0][0]*p[1][1]-p[0][1]*p[1][0])%26;
    if(det<0) det+=26;

    for(i=1;i<26;i++)
        if((det*i)%26==1)
            break;

    if(i==26)
    {
        printf("Plaintext matrix is not invertible");
        return 0;
    }

    inv=i;

    k[0][0]=(inv*(p[1][1]*c[0][0]-p[0][1]*c[1][0]))%26;
    k[0][1]=(inv*(p[1][1]*c[0][1]-p[0][1]*c[1][1]))%26;
    k[1][0]=(inv*(-p[1][0]*c[0][0]+p[0][0]*c[1][0]))%26;
    k[1][1]=(inv*(-p[1][0]*c[0][1]+p[0][0]*c[1][1]))%26;

    printf("\nRecovered Hill Cipher Key:\n");
    for(i=0;i<2;i++)
    {
        for(j=0;j<2;j++)
        {
            k[i][j]=(k[i][j]%26+26)%26;
            printf("%d ",k[i][j]);
        }
        printf("\n");
    }

    return 0;
}

Sample Input
Enter 4 plaintext values (0-25):
1 0
0 1
Enter 4 ciphertext values (0-25):
9 4
5 7

Sample Output
Recovered Hill Cipher Key:
9 4
5 7
