#include <stdio.h>
#include <string.h>

int main() {
    char m[5][5] = {
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };

    char p[] = "MUSTSEEYOUOVERCADOGANWESTCOMINGATONCE";
    int i,j,r1,c1,r2,c2;

    printf("Ciphertext: ");

    for(i=0; p[i]; i+=2) {
        for(j=0;j<25;j++) {
            if(m[j/5][j%5]==p[i])
                r1=j/5,c1=j%5;
            if(m[j/5][j%5]==p[i+1])
                r2=j/5,c2=j%5;
        }

        if(r1==r2)
            printf("%c%c",m[r1][(c1+1)%5],
                           m[r2][(c2+1)%5]);
        else if(c1==c2)
            printf("%c%c",m[(r1+1)%5][c1],
                           m[(r2+1)%5][c2]);
        else
            printf("%c%c",m[r1][c2],m[r2][c1]);
    }

    return 0;
}

