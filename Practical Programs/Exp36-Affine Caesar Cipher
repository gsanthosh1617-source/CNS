#include <stdio.h>
#include <string.h>

int gcd(int a,int b)
{
    while(b!=0)
    {
        int t=b;
        b=a%b;
        a=t;
    }
    return a;
}

int main()
{
    char text[100];
    int a,b,i,p,c;

    printf("Enter plaintext: ");
    scanf("%99s",text);

    printf("Enter values of a and b: ");
    scanf("%d%d",&a,&b);

    if(gcd(a,26)!=1)
    {
        printf("Invalid key: a must be coprime with 26");
        return 0;
    }

    printf("Encrypted text: ");
    for(i=0;text[i]!='\0';i++)
    {
        p=text[i]-'A';
        c=(a*p+b)%26;
        printf("%c",c+'A');
    }

    return 0;
}

Sample Input
Enter plaintext: HELLO
Enter values of a and b: 5 3

Sample Output
Encrypted text: RCLLA
