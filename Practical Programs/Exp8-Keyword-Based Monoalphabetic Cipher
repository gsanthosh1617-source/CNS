#include <stdio.h>
#include <ctype.h>

int main() {
    char key[] = "CIPHER", p[100], cipher[26];
    int used[26] = {0}, i, k = 0;

    for (i = 0; key[i]; i++) {
        int x = toupper(key[i]) - 'A';
        if (!used[x])
            cipher[k++] = toupper(key[i]), used[x] = 1;
    }

    for (i = 0; i < 26; i++)
        if (!used[i])
            cipher[k++] = 'A' + i;

    printf("Enter plaintext: ");
    scanf("%s", p);

    printf("Ciphertext: ");
    for (i = 0; p[i]; i++)
        printf("%c", cipher[toupper(p[i]) - 'A']);

    return 0;
}

Sample Input
Plaintext: HELLO
Keyword: CIPHER

Sample Output
Ciphertext: BEJJM
