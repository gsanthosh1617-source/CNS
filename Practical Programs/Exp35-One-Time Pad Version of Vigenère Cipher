#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int key[100], cipher[100], n, i;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    n = strlen(text);

    printf("Enter %d key values (0-25): ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("\nEncrypted Text: ");
    for (i = 0; i < n; i++) {
        cipher[i] = ((text[i] - 'A' + key[i]) % 26);
        printf("%c", cipher[i] + 'A');
    }

    printf("\nDecrypted Text: ");
    for (i = 0; i < n; i++) {
        printf("%c", ((cipher[i] - key[i] + 26) % 26) + 'A');
    }

    return 0;
}

Sample Input
Enter plaintext: HELLO
Enter 5 key values (0-25): 3 19 5 7 11

Sample Output
Encrypted Text: KXQSW
Decrypted Text: HELLO
