#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char c[200], p[200];
    double f[26]={8.2,1.5,2.8,4.3,12.7,2.2,2.0,6.1,7.0,
                  0.15,0.77,4.0,2.4,6.7,7.5,1.9,0.095,6.0,
                  6.3,9.1,2.8,0.98,2.4,0.15,2.0,0.074};
    int i,k,n;
    double score;

    printf("Enter ciphertext: ");
    scanf("%s",c);

    printf("Enter number of results: ");
    scanf("%d",&n);

    if(n > 26) n = 26;

    for(k=0;k<26;k++) {
        score=0;

        for(i=0;c[i];i++) {
            int x=(c[i]-'A'-k+26)%26;
            score += f[x];
        }

        printf("Key %2d : ",k);

        for(i=0;c[i];i++)
            printf("%c",(c[i]-'A'-k+26)%26+'A');

        printf("  Score = %.2f\n",score);
    }

    return 0;
}

