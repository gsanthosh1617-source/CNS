#include <stdio.h>
int main()
{
    int n = 3599, e = 31, p, q, phi;
    int d, i;

    for(i = 2; i < n; i++)
    {
        if(n % i == 0)
        {
            p = i;
            q = n / i;
            break;
        }
    }

    phi = (p - 1) * (q - 1);

    for(d = 1; d < phi; d++)
    {
        if((e * d) % phi == 1)
            break;
    }

    printf("p = %d\nq = %d\n", p, q);
    printf("Phi(n) = %d\n", phi);
    printf("Public key = (%d, %d)\n", e, n);
    printf("Private key d = %d\n", d);

    return 0;
}

SAMPLE INPUT
e = 31
n = 3599

SAMPLE OUTPUT
p = 59
q = 61
Phi(n) = 3480
Public key = (31, 3599)
Private key d = 2011
