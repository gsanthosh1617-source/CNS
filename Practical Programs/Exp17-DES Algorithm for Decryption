#include <stdio.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key = { '1','2','3','4','5','6','7','8' };
    DES_cblock plain = { 'A','B','C','D','E','F','G','H' };
    DES_cblock cipher, output;
    DES_key_schedule ks;
    int i;

    DES_set_key_unchecked(&key, &ks);

    DES_ecb_encrypt(&plain, &cipher, &ks, DES_ENCRYPT);
    DES_ecb_encrypt(&cipher, &output, &ks, DES_DECRYPT);

    printf("Ciphertext: ");
    for(i = 0; i < 8; i++)
        printf("%02X ", cipher[i]);

    printf("\nDecrypted text: ");
    for(i = 0; i < 8; i++)
        printf("%c", output[i]);

    printf("\n");
    return 0;
}

Sample Input
Key: 12345678
Plaintext: ABCDEFGH

Sample Output
Ciphertext: [DES-generated hexadecimal ciphertext]
Decrypted text: ABCDEFGH
