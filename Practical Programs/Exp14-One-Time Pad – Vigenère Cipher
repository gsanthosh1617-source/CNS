#include <stdio.h>
#include <string.h>

int main() {
    char p[] = "sendmoremoney";
    char target[] = "cashnotneeded";
    int k[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    int c[20], key[20], i;

    printf("Ciphertext: ");
    for(i=0; p[i]; i++) {
        c[i] = (p[i]-'a' + k[i]) % 26;
        printf("%c", c[i]+'a');
    }

    printf("\nKey for 'cashnotneeded': ");
    for(i=0; target[i]; i++) {
        key[i] = ((target[i]-'a') - c[i] + 26) % 26;
        printf("%d ", key[i]);
    }

    return 0;
}

