#include <stdio.h>
#include <ctype.h>

int main() {
    char key[] = "ROYAL", c[] =
    "KXJEYUREBEZWEHEWRYTUHEYFSKREHEGOYFIWTTTUOLKSYCAJPO"
    "BOTEIZONTXBYBNTGONEYCUZWRGDSONSXBOUYWRHEBAAHYUSEDQ";
    char m[25], used[26]={0};
    int i,j,k=0,r1,r2,c1,c2;

    for(i=0;key[i];i++) {
        char x=toupper(key[i]);
        if(x=='J') x='I';
        if(!used[x-'A']) m[k++]=x,used[x-'A']=1;
    }

    for(i=0;i<26;i++)
        if(i!=9 && !used[i]) m[k++]='A'+i;

    printf("Plaintext: ");
    for(i=0;c[i];i+=2) {
        char x=c[i],y=c[i+1];

        for(j=0;j<25;j++) {
            if(m[j]==x) r1=j/5,c1=j%5;
            if(m[j]==y) r2=j/5,c2=j%5;
        }

        if(r1==r2)
            printf("%c%c",m[r1*5+(c1+4)%5],
                           m[r2*5+(c2+4)%5]);
        else if(c1==c2)
            printf("%c%c",m[((r1+4)%5)*5+c1],
                           m[((r2+4)%5)*5+c2]);
        else
            printf("%c%c",m[r1*5+c2],m[r2*5+c1]);
    }

    return 0;
}

