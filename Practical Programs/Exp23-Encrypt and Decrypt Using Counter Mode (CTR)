#include <stdio.h>
int main()
{
    int p[3] = {1, 2, 4}, c[3], d[3];
    int a = 5, b = 8, i, k;

    for(i = 0; i < 3; i++)
    {
        k = (a * i + b) % 256;
        c[i] = p[i] ^ k;
    }

    printf("Ciphertext: ");
    for(i = 0; i < 3; i++)
        printf("%d ", c[i]);

    for(i = 0; i < 3; i++)
    {
        k = (a * i + b) % 256;
        d[i] = c[i] ^ k;
    }

    printf("\nDecrypted plaintext: ");
    for(i = 0; i < 3; i++)
        printf("%d ", d[i]);

    return 0;
}

SAMPLE INPUT
Plaintext: 1 2 4
Counter: 0
a = 5, b = 8

SAMPLE OUTPUT
Ciphertext: 9 15 18
Decrypted plaintext: 1 2 4
