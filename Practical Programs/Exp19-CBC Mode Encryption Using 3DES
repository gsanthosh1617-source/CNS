#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key1 = "12345678";
    DES_cblock key2 = "ABCDEFGH";
    DES_cblock key3 = "87654321";
    DES_cblock iv = "INITVECT";
    DES_key_schedule ks1, ks2, ks3;
    unsigned char text[100] = "HELLO CBC MODE";
    int len = strlen((char *)text), i;

    len = ((len + 7) / 8) * 8;
    memset(text + strlen((char *)text), 0,
           len - strlen((char *)text));

    DES_set_key_unchecked(&key1, &ks1);
    DES_set_key_unchecked(&key2, &ks2);
    DES_set_key_unchecked(&key3, &ks3);

    DES_ede3_cbc_encrypt(text, text, len,
                         &ks1, &ks2, &ks3, &iv,
                         DES_ENCRYPT);

    printf("Ciphertext: ");
    for(i = 0; i < len; i++)
        printf("%02X ", text[i]);

    printf("\n");
    return 0;
}

Sample Input
Plaintext: HELLO CBC MODE
Key 1: 12345678
Key 2: ABCDEFGH
Key 3: 87654321
IV: INITVECT

Sample Output
Ciphertext: [Encrypted hexadecimal ciphertext]
